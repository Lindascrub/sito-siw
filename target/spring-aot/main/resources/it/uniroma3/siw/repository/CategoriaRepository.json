    {
      "name": "findByNome",
      "signature": "public abstract java.util.List<it.uniroma3.siw.model.Categoria> it.uniroma3.siw.repository.CategoriaRepository.findByNome(java.lang.String)",
      "query": {
        "query": "SELECT c FROM Categoria c WHERE c.nome = :nome"
      }
    },
    {
      "name": "findByNomeContainingIgnoreCase",
      "signature": "public abstract java.util.List<it.uniroma3.siw.model.Categoria> it.uniroma3.siw.repository.CategoriaRepository.findByNomeContainingIgnoreCase(java.lang.String)",
      "query": {
        "query": "SELECT c FROM Categoria c WHERE UPPER(c.nome) LIKE UPPER(:nome) ESCAPE '\\'"
      }
